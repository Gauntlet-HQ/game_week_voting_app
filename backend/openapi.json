{
  "openapi": "3.0.3",
  "info": {
    "title": "Game Week Voting API",
    "version": "0.1.0",
    "description": "Honor-system voter roster, one vote per award category, shared staff password for CSV upload and results."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque-signed-token",
        "description": "Session token from POST /sessions. Encodes voter_id and isStaff."
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/voters": {
      "get": {
        "summary": "List roster display names for the honor-system name picker",
        "tags": [
          "voters"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "voters"
                  ],
                  "properties": {
                    "voters": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "displayName"
                        ],
                        "properties": {
                          "displayName": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "post": {
        "summary": "Start a session by picking a roster name (optional shared staff password)",
        "tags": [
          "sessions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "displayName"
                ],
                "additionalProperties": false,
                "properties": {
                  "displayName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "staffPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token",
                    "voterId",
                    "displayName",
                    "isStaff"
                  ],
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "voterId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "isStaff": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/games": {
      "get": {
        "summary": "List games that have not been withdrawn from the ballot",
        "tags": [
          "games"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "games"
                  ],
                  "properties": {
                    "games": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "gameId",
                          "title",
                          "submitterName",
                          "url"
                        ],
                        "properties": {
                          "gameId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "title": {
                            "type": "string"
                          },
                          "submitterName": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ballot": {
      "get": {
        "summary": "Read the current voter's ballot draft or locked ballot",
        "tags": [
          "ballot"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ballotId",
                    "isLocked",
                    "lockedAt",
                    "votes"
                  ],
                  "properties": {
                    "ballotId": {
                      "type": [
                        "null",
                        "string"
                      ],
                      "format": "uuid"
                    },
                    "isLocked": {
                      "type": "boolean"
                    },
                    "lockedAt": {
                      "type": [
                        "null",
                        "string"
                      ],
                      "format": "date-time"
                    },
                    "votes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "category",
                          "gameId"
                        ],
                        "properties": {
                          "category": {
                            "type": "string",
                            "enum": [
                              "technical_achievement",
                              "creative_or_fun_gameplay",
                              "visuals_or_graphics",
                              "best_overall"
                            ]
                          },
                          "gameId": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace the current voter's unlocked ballot draft",
        "tags": [
          "ballot"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "votes"
                ],
                "additionalProperties": false,
                "properties": {
                  "votes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "category",
                        "gameId"
                      ],
                      "properties": {
                        "category": {
                          "type": "string",
                          "enum": [
                            "technical_achievement",
                            "creative_or_fun_gameplay",
                            "visuals_or_graphics",
                            "best_overall"
                          ]
                        },
                        "gameId": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ballotId",
                    "isLocked",
                    "lockedAt",
                    "votes"
                  ],
                  "properties": {
                    "ballotId": {
                      "type": [
                        "null",
                        "string"
                      ],
                      "format": "uuid"
                    },
                    "isLocked": {
                      "type": "boolean"
                    },
                    "lockedAt": {
                      "type": [
                        "null",
                        "string"
                      ],
                      "format": "date-time"
                    },
                    "votes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "category",
                          "gameId"
                        ],
                        "properties": {
                          "category": {
                            "type": "string",
                            "enum": [
                              "technical_achievement",
                              "creative_or_fun_gameplay",
                              "visuals_or_graphics",
                              "best_overall"
                            ]
                          },
                          "gameId": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ballot/lock": {
      "post": {
        "summary": "Lock the current voter's ballot after all four categories are filled",
        "tags": [
          "ballot"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ballotId",
                    "isLocked",
                    "lockedAt",
                    "votes"
                  ],
                  "properties": {
                    "ballotId": {
                      "type": [
                        "null",
                        "string"
                      ],
                      "format": "uuid"
                    },
                    "isLocked": {
                      "type": "boolean"
                    },
                    "lockedAt": {
                      "type": [
                        "null",
                        "string"
                      ],
                      "format": "date-time"
                    },
                    "votes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "category",
                          "gameId"
                        ],
                        "properties": {
                          "category": {
                            "type": "string",
                            "enum": [
                              "technical_achievement",
                              "creative_or_fun_gameplay",
                              "visuals_or_graphics",
                              "best_overall"
                            ]
                          },
                          "gameId": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/staff/games/import": {
      "post": {
        "summary": "Upsert games from CSV (title, submitter_name, url)",
        "tags": [
          "staff"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "upserted",
                    "deleted",
                    "withdrawn"
                  ],
                  "properties": {
                    "upserted": {
                      "type": "integer"
                    },
                    "deleted": {
                      "type": "integer"
                    },
                    "withdrawn": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/staff/voters/import": {
      "post": {
        "summary": "Upsert the voter roster from CSV (display_name, is_staff)",
        "tags": [
          "staff"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "upserted",
                    "deleted",
                    "keptBecauseBallotExists"
                  ],
                  "properties": {
                    "upserted": {
                      "type": "integer"
                    },
                    "deleted": {
                      "type": "integer"
                    },
                    "keptBecauseBallotExists": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/staff/results": {
      "get": {
        "summary": "Tally locked ballots only; equal vote counts share a rank",
        "tags": [
          "staff"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "lockedBallotCount",
                    "categories"
                  ],
                  "properties": {
                    "lockedBallotCount": {
                      "type": "integer"
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "category",
                          "standings"
                        ],
                        "properties": {
                          "category": {
                            "type": "string",
                            "enum": [
                              "technical_achievement",
                              "creative_or_fun_gameplay",
                              "visuals_or_graphics",
                              "best_overall"
                            ]
                          },
                          "standings": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "rank",
                                "voteCount",
                                "isTied",
                                "game"
                              ],
                              "properties": {
                                "rank": {
                                  "type": "integer"
                                },
                                "voteCount": {
                                  "type": "integer"
                                },
                                "isTied": {
                                  "type": "boolean"
                                },
                                "game": {
                                  "type": "object",
                                  "required": [
                                    "gameId",
                                    "title",
                                    "submitterName",
                                    "url"
                                  ],
                                  "properties": {
                                    "gameId": {
                                      "type": "string",
                                      "format": "uuid"
                                    },
                                    "title": {
                                      "type": "string"
                                    },
                                    "submitterName": {
                                      "type": "string"
                                    },
                                    "url": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "meta",
      "description": "Health and documentation"
    },
    {
      "name": "voters",
      "description": "Public roster name picker"
    },
    {
      "name": "sessions",
      "description": "Honor-system sessions"
    },
    {
      "name": "games",
      "description": "Active ballot games"
    },
    {
      "name": "ballot",
      "description": "Draft and lock a voter's ballot"
    },
    {
      "name": "staff",
      "description": "Shared-password staff import and results"
    }
  ]
}
